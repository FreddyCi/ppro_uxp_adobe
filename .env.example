# Server Environment Variables for Azure Ingest Server
# This file contains the Azure Storage connection string for the backend server

# Environment
NODE_ENV=development
VITE_ENVIRONMENT=development
VITE_STORAGE_MODE=local

# Project Paths
PROJECT_ROOT=/path/to/your/project
UXP_DIST_PATH=${PROJECT_ROOT}/dist

# Adobe IMS OAuth Configuration (Development)
VITE_IMS_CLIENT_ID=your_ims_client_id_here
VITE_IMS_CLIENT_SECRET=your_ims_client_secret_here
VITE_IMS_ORG_ID=your_ims_org_id_here@AdobeOrg
VITE_IMS_SCOPES=firefly_api,ff_apis,AdobeID,openid,firefly_enterprise
VITE_IMS_URL=https://ims-na1.adobelogin.com

# Google Gemini Configuration
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-2.5-flash-image-preview
VITE_GEMINI_API_URL=https://generativelanguage.googleapis.com

# LTX-2 API
VITE_LTX_API_KEY=your_ltx_api_key_here

# LUMA API
VITE_LUMA_API_KEY=your_luma_api_key_here

# Fal.ai Configuration for Video Generation
VITE_FAL_API_KEY=your_fal_api_key_here
VITE_FAL_ADMIN=your_fal_admin_key_here
VITE_FAL_BASE_URL=https://fal.run
VITE_FAL_MODEL_ID=fal-ai/wan-flf2v
VITE_FAL_ENDPOINT=https://fal.run/fal-ai/wan-flf2v

# Azure Storage Configuration (CRITICAL FOR SERVER)
VITE_AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
VITE_AZURE_STORAGE_ACCOUNT_KEY=your_storage_account_key_here
VITE_AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_storage_account_name;AccountKey=your_storage_account_key_here;EndpointSuffix=core.windows.net

# Server needs non-VITE prefixed version
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_storage_account_name;AccountKey=your_storage_account_key_here;EndpointSuffix=core.windows.net

# Azure Subscription
VITE_AZURE_SUBSCRIPTION_ID=your_subscription_id_here

# Container Names
VITE_AZURE_CONTAINER_IMAGES=uxp-images
VITE_AZURE_CONTAINER_VIDEOS=uxp-videos
VITE_AZURE_CONTAINER_TEMP=uxp-temp
VITE_AZURE_CONTAINER_EXPORTS=uxp-exports

# Server Configuration
AZURE_INGEST_PORT=3001

# Development Flags
DEBUG_MODE=true
ENABLE_TELEMETRY=false
MOCK_API_CALLS=false

# Local Content Storage Path
LOCAL_CONTENT_PATH=/path/to/local/content

VITE_AZURE_CONTAINER_SAS_URL=https://your_storage_account_name.blob.core.windows.net/uxp-images?sv=2025-07-05&spr=https&st=2025-10-01T03%3A27%3A04Z&se=2025-12-30T03%3A28%3A04Z&sr=c&sp=racw&sig=your_sas_signature_here